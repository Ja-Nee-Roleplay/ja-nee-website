<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|version\.json)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(?:pdf|svg|png|jpe?g|webp|avif|woff2?|js|css)$">
    Header always set Cache-Control "public, max-age=60, must-revalidate"
  </FilesMatch>

  <FilesMatch "[-.][A-Za-z0-9_-]{8,}\.(?:pdf|svg|png|jpe?g|webp|avif|woff2?|js|css)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
